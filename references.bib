  title = {Global {{Ocean Colour}} ({{Copernicus-GlobColour}}), {{Bio-Geo-Chemical}}, {{L4}} (Monthly and Interpolated) from {{Satellite Observations}} (1997-Ongoing)},
  author = {{European Union-Copernicus Marine Service}},
